# ============================================================
# generic-persona-skill —— 本地配置模板（P2.2）
#
# 用法：
#   1. 复制本文件为 `.env`（`cp .env.example .env`）
#   2. 按需修改下面的**非敏感**配置
#   3. `.env` 本身已被 .gitignore 忽略，不会被提交
#
# ⚠️ 两条安全红线：
#   - 本文件**只放非敏感配置**。真实密钥一律用**环境变量**设置，
#     不要写进任何文件（包括这里）。
#   - 如果 `.env` 里出现了敏感变量，程序会**忽略它并告警**，不会静默使用。
#
# 优先级（由低到高）：内置默认值 < .env < 环境变量 < 显式 overrides
# 说明文档：docs/CONFIG.md
# ============================================================

# ---------- 运行模式与日志（非敏感）----------
# 可选：dev / test / prod
PERSONA_MODE=dev
# 可选：DEBUG / INFO / WARNING / ERROR
PERSONA_LOG_LEVEL=INFO

# ---------- 数据目录（非敏感）----------
# 相对路径以**当前工作目录**为基准
PERSONA_DATA_DIR=var
PERSONA_DATABASE_FILENAME=persona.db

# ---------- Provider 与离线开关（非敏感）----------
# 当前可选：
#   fake / recording / failing / offline_guard   —— Mock 家族（离线、无需密钥）
#   tavily                                      —— 真实搜索 Provider（需联网 + 密钥）
# 注意：真实 Provider（tavily）与离线开关互斥——PERSONA_OFFLINE_ONLY=true 时
# 不得选 tavily；选 tavily 时必须设 PERSONA_OFFLINE_ONLY=false 并提供搜索密钥。
PERSONA_PROVIDER=fake
# true = 禁止任何真实外部调用（默认，安全）；false = 允许真实调用（此时必须提供密钥）
PERSONA_OFFLINE_ONLY=true

# ---------- 研究量级上限（非敏感；仅 Tavily / 真实搜索生效）----------
# 这些是对外暴露的"搜索服务商无关"的通用研究上限，复用同一套限制逻辑：
#   SEARCH_PROVIDER          —— PERSONA_PROVIDER 的顺手别名
#   RESEARCH_MAX_QUERIES     —— 一次研究最多发起多少次检索（默认 5）
#   RESEARCH_MAX_RESULTS     —— 每次检索最多保留多少条结果（默认 5）
#   RESEARCH_MAX_EXTRACTS    —— 一次研究最多抓取多少篇网页正文（0 = 不抓取，默认 3）
#   RESEARCH_MAX_REMEDIATIONS —— 每个 URL 最多补救几次：正文低质量时用官方参数
#                               （format=text 等）重抓一次；每次补救都计入用量账本、
#                               受 max_cost 约束（默认 1，0 = 不补救）
#   RESEARCH_MAX_COST        —— 一次研究的成本上限；留空表示不限制。
#                               单位跟随 Provider 申明的 `UsageDelta.currency`：
#                               Tavily 为 credit（usage.credits），不是货币。
#                               Provider 未回报成本时该闸门无法判定，会记
#                               COST_CEILING_UNENFORCEABLE 告警（不用估计值冒充）。
SEARCH_PROVIDER=fake
RESEARCH_MAX_QUERIES=5
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_EXTRACTS=3
RESEARCH_MAX_REMEDIATIONS=1
RESEARCH_MAX_COST=

# ---------- 模型抽取（G-2）—— 服务商决策与预算（P4.4-B / P4.4-C 拍板）----------
# 决策：服务商 DeepSeek API / 模型 deepseek-flash / 币种 USD。
# **币种固定 USD，不做汇率换算**（P4.4-C 拍板）：DeepSeek 官方计价即 USD，
# 一本账只会有一种币；原 USD→CNY 折算字段已移除——汇率是会过期的商业条款，
# 折算结果又不参与任何预算判定，留着只会多一个"看起来算了其实没算"的数。
#
# ⚠️ 这里是**离线安全**的一组值：PERSONA_MODEL_PROVIDER 留空 = **不启用模型抽取**，
#    所以直接复制本文件也不会联网、不会花钱。
#    要真正启用，必须同时满足三件事（缺一个配置校验就会拒绝加载，而不是悄悄放行）：
#      1) PERSONA_MODEL_PROVIDER=deepseek
#      2) PERSONA_OFFLINE_ONLY=false
#      3) 环境变量里有模型密钥：PERSONA_PROVIDER_API_KEY 或别名 DEEPSEEK_API_KEY
#         （**密钥只放环境变量，严禁写进本文件**；本文件里写了会被忽略并告警）
#
# 单价单位 = 原币 / 每 100 万 token（与服务商价目表一致）。
# 价格是**时点数据**：来源与核对日期必须一起记录，否则配置校验不通过。
#   —— 来源：https://api-docs.deepseek.com/quick_start/pricing （2026-10-16 核对）
#   —— deepseek-flash 官方价（USD / 1M token，均按 **cache miss** 取，保守）：
#        档位        输入(cache miss)   输出      输入(cache hit)
#        off_peak    0.15              0.60      0.003
#        peak        0.30              1.20      0.006
#   —— 官方原文：Off-peak rates are half of the peak rates. Peak hours are
#      01:00 - 04:00 and 06:00 - 10:00 UTC, Monday through Friday, excluding
#      Chinese public holidays. All other hours are off-peak.
#
# 档位怎么选（P4.4-B 按"每次请求前按**可能产生的最大费用**预留"取保守档）：
#   peak = 保守（预留更大；账面按峰时费率推算，可能比实际账单高）
#   若确认整个冒烟过程都落在闲时，可改成 off_peak（账面更贴近实际，但预留更乐观）
PERSONA_MODEL_PROVIDER=
PERSONA_MODEL_ID=deepseek-flash
PERSONA_MODEL_CURRENCY=USD
PERSONA_MODEL_PRICE_TIER=peak
PERSONA_MODEL_PRICE_IN_PER_1M=0.3
PERSONA_MODEL_PRICE_OUT_PER_1M=1.2
PERSONA_MODEL_PRICE_SOURCE=https://api-docs.deepseek.com/quick_start/pricing
PERSONA_MODEL_PRICE_CHECKED_AT=2026-10-16

# 预算：总上限（本轮/本账本累计）与单任务上限。两者都留空 = 不限制金额。
#
# P4.4-C 拍板：**先用保守的单任务上限，总上限暂取同一个值**（0.25 USD）。
# 项目级封顶 $1.00 仍然成立（一次冒烟远达不到），但"总上限独立生效"需要
# "共享账本 + 任务级计数"两层机制，属新增能力，**列为遗留项，本轮不实现**。
# 因此当前配置下两个上限相等，实际生效的就是 0.25。
#
# 硬规矩：设了金额上限 → **必须**同时给出输入/输出两个单价 + 事前 token 估算，
# 否则配置校验不通过（没有单价/没有估算就算不出"本次可能的最大费用"，
# 闸门不会用估计值冒充，只会拒绝自动发起请求）。
PERSONA_MODEL_MAX_COST=0.25
PERSONA_MODEL_MAX_COST_PER_TASK=0.25
PERSONA_MODEL_MAX_CALLS=1
# 事前 token 估算（保守即可；它只用于**预留**，实际结算用响应回报的真实 token 数）
PERSONA_MODEL_EST_TOKENS_IN=3000
PERSONA_MODEL_EST_TOKENS_OUT=2000

# gate 开关：true = 材料必须亮出正文质量门禁结论才允许进抽取器（P4.4-B 决策）
PERSONA_MODEL_REQUIRE_GATE_VERDICT=true

# ---------- 预算上限（非敏感）----------
# 超预算的行为是**暂停并保存进度**，不是失败
PERSONA_BUDGET_MAX_REQUESTS=200
PERSONA_BUDGET_MAX_TOKENS_IN=500000
PERSONA_BUDGET_MAX_TOKENS_OUT=200000
# 留空表示该项不限制
PERSONA_BUDGET_MAX_COST=
PERSONA_BUDGET_MAX_DURATION_SEC=

# ---------- 重试与超时（非敏感）----------
PERSONA_RETRY_MAX_RETRIES=3
PERSONA_RETRY_BACKOFF_BASE_MS=500
PERSONA_RETRY_BACKOFF_MAX_MS=8000
PERSONA_RETRY_JITTER=true
PERSONA_RETRY_TIMEOUT_MS=30000
PERSONA_RETRY_RESPECT_RETRY_AFTER=true

# ============================================================
# 敏感配置 —— **不要写在这里**，请设为环境变量：
#
#   Windows PowerShell:
#     $env:PERSONA_PROVIDER_API_KEY = "你的密钥"
#   Git Bash / Linux / macOS:
#     export PERSONA_PROVIDER_API_KEY="你的密钥"
#
# 别名（同一件事，两种写法；`PERSONA_*` 本体优先）：
#     PERSONA_SEARCH_API_KEY  或  TAVILY_API_KEY     —— 真实搜索 Provider
#     PERSONA_PROVIDER_API_KEY 或  DEEPSEEK_API_KEY  —— 真实模型 Provider
#
# PERSONA_PROVIDER_API_KEY=<留空，用环境变量>
# PERSONA_SEARCH_API_KEY=<留空，用环境变量>
# ============================================================
