# ============================================================
# generic-persona-skill —— 本地配置模板（P2.2）
#
# 用法：
#   1. 复制本文件为 `.env`（`cp .env.example .env`）
#   2. 按需修改下面的**非敏感**配置
#   3. `.env` 本身已被 .gitignore 忽略，不会被提交
#
# ⚠️ 两条安全红线：
#   - 本文件**只放非敏感配置**。真实密钥一律用**环境变量**设置，
#     不要写进任何文件（包括这里）。
#   - 如果 `.env` 里出现了敏感变量，程序会**忽略它并告警**，不会静默使用。
#
# 优先级（由低到高）：内置默认值 < .env < 环境变量 < 显式 overrides
# 说明文档：docs/CONFIG.md
# ============================================================

# ---------- 运行模式与日志（非敏感）----------
# 可选：dev / test / prod
PERSONA_MODE=dev
# 可选：DEBUG / INFO / WARNING / ERROR
PERSONA_LOG_LEVEL=INFO

# ---------- 数据目录（非敏感）----------
# 相对路径以**当前工作目录**为基准
PERSONA_DATA_DIR=var
PERSONA_DATABASE_FILENAME=persona.db

# ---------- Provider 与离线开关（非敏感）----------
# 当前可选：
#   fake / recording / failing / offline_guard   —— Mock 家族（离线、无需密钥）
#   tavily                                      —— 真实搜索 Provider（需联网 + 密钥）
# 注意：真实 Provider（tavily）与离线开关互斥——PERSONA_OFFLINE_ONLY=true 时
# 不得选 tavily；选 tavily 时必须设 PERSONA_OFFLINE_ONLY=false 并提供搜索密钥。
PERSONA_PROVIDER=fake
# true = 禁止任何真实外部调用（默认，安全）；false = 允许真实调用（此时必须提供密钥）
PERSONA_OFFLINE_ONLY=true

# ---------- 研究量级上限（非敏感；仅 Tavily / 真实搜索生效）----------
# 这些是对外暴露的"搜索服务商无关"的通用研究上限，复用同一套限制逻辑：
#   SEARCH_PROVIDER          —— PERSONA_PROVIDER 的顺手别名
#   RESEARCH_MAX_QUERIES     —— 一次研究最多发起多少次检索（默认 5）
#   RESEARCH_MAX_RESULTS     —— 每次检索最多保留多少条结果（默认 5）
#   RESEARCH_MAX_EXTRACTS    —— 一次研究最多抓取多少篇网页正文（0 = 不抓取，默认 3）
#   RESEARCH_MAX_COST        —— 一次研究的成本上限；留空表示不限制。
#                               单位跟随 Provider 申明的 `UsageDelta.currency`：
#                               Tavily 为 credit（usage.credits），不是货币。
#                               Provider 未回报成本时该闸门无法判定，会记
#                               COST_CEILING_UNENFORCEABLE 告警（不用估计值冒充）。
SEARCH_PROVIDER=fake
RESEARCH_MAX_QUERIES=5
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_EXTRACTS=3
RESEARCH_MAX_COST=

# ---------- 预算上限（非敏感）----------
# 超预算的行为是**暂停并保存进度**，不是失败
PERSONA_BUDGET_MAX_REQUESTS=200
PERSONA_BUDGET_MAX_TOKENS_IN=500000
PERSONA_BUDGET_MAX_TOKENS_OUT=200000
# 留空表示该项不限制
PERSONA_BUDGET_MAX_COST=
PERSONA_BUDGET_MAX_DURATION_SEC=

# ---------- 重试与超时（非敏感）----------
PERSONA_RETRY_MAX_RETRIES=3
PERSONA_RETRY_BACKOFF_BASE_MS=500
PERSONA_RETRY_BACKOFF_MAX_MS=8000
PERSONA_RETRY_JITTER=true
PERSONA_RETRY_TIMEOUT_MS=30000
PERSONA_RETRY_RESPECT_RETRY_AFTER=true

# ============================================================
# 敏感配置 —— **不要写在这里**，请设为环境变量：
#
#   Windows PowerShell:
#     $env:PERSONA_PROVIDER_API_KEY = "你的密钥"
#   Git Bash / Linux / macOS:
#     export PERSONA_PROVIDER_API_KEY="你的密钥"
#
# PERSONA_PROVIDER_API_KEY=<留空，用环境变量>
# PERSONA_SEARCH_API_KEY=<留空，用环境变量>
# ============================================================
