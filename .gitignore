# ============================================================
# generic-persona-skill —— Git 忽略规则（P2.1）
# 目标：虚拟环境 / 密钥 / 缓存 / 本地数据库 / 构建产物，一律不入库
# 注意：本仓库目前尚未 git init；此文件在初始化后自动生效
# ============================================================

# ---------- 1. Python 缓存与字节码 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 2. 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.virtualenv/
pyvenv.cfg

# ---------- 3. 密钥与本地配置（严禁入库，也严禁读取输出其内容）----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
secrets.*
credentials.json
*_credentials.*
.token
*.token

# ---------- 4. 本地数据库与运行数据 ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
data/
var/
workspace/
runs/

# ---------- 5. 测试与类型检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- 6. 构建与分发产物 ----------
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ---------- 7. 编辑器与操作系统 ----------
.idea/
.vscode/
.agents/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 8. 日志 ----------
*.log
logs/
